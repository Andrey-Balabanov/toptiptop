  .thumb-pad svg { width: 38px; }
  .side-panel { width: 320px; right: -340px; }
  .side-panel.open { right: 0; }
  .keyboard { margin-top: 8px; }
  .kb-row { gap: 2px; }

  .app.focus-mode .key { width: 38px; height: 38px; font-size: 13px; }
  .app.focus-mode .key.shift { width: 62px; font-size: 15px; }
  .app.focus-mode .key.space { width: 160px; font-size: 17px; }
  .app.focus-mode .finger { width: 52px; }
  .app.focus-mode .finger .pad svg { transform: scale(1.12); }
  .app.focus-mode .finger .home { font-size: 12px; min-width: 28px; }
  .app.focus-mode .finger .name { font-size: 10px; max-width: 52px; }
  .app.focus-mode .thumb-pad svg { width: 44px; }
  .app.focus-mode .text-display { font-size: min(3.5vw, 26px); padding: 14px 16px; }
  .app.focus-mode .text-display .char { font-size: min(3.5vw, 26px); }
}

/* ---- DESKTOP (>= 801px) ---- */
@media (min-width: 801px) {
  .app.start-mode {
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-rows: auto auto auto auto 1fr auto;
    gap: 6px;
    min-height: calc(100vh - 16px);
    overflow: hidden;
  }

  .app.start-mode > .auth-bar          { grid-column: 1 / -1; grid-row: 1; }

  .app.start-mode > .top-bar           { grid-column: 1; grid-row: 2; }
  .app.start-mode > .stats-row         { grid-column: 1; grid-row: 3; }
  .app.start-mode > .controls-row      { grid-column: 1; grid-row: 4; }
  .app.start-mode > .start-btn-wrap    { grid-column: 1; grid-row: 5; justify-self: center; align-self: center; }

  .app.start-mode > .ach-panel {
    grid-column: 2;
    grid-row: 2 / 6;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .app.start-mode > .footnote          { grid-column: 1 / -1; grid-row: 6; }

  .app.start-mode .top-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    padding: 7px 10px;
  }
  .lvl-badge { width: 32px; height: 32px; font-size: 14px; }
  .lvl-title { font-size: 12px; }
  .xp-compact { font-size: 10px; }
  .xp-mini { width: 100%; height: 4px; }
  .score-compact { text-align: left; margin-left: 0; width: 100%; }
  .sc-value { font-size: 16px; }

  .app.start-mode .stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px 8px;
    padding: 5px 10px;
  }
  .stat-item { flex: 0; }
  .st-label { font-size: 9px; }
  .st-value { font-size: 13px; }

  .app.start-mode .controls-row {
    flex-direction: column;
    gap: 3px;
    padding: 5px 10px;
  }
  .controls-row button, .controls-row select {
    width: 100%;
    padding: 5px 8px;
    font-size: 11px;
  }
  #keyboard-layout-select { width: 100%; padding: 5px 8px; font-size: 11px; }
  #sidebar-btn-group button.small { font-size: 10px !important; padding: 4px 6px !important; }

  .app.start-mode .ach-panel {
    padding: 12px 14px;
  }
  .app.start-mode .ach-panel h2 {
    font-size: 10px;
    margin-bottom: 6px;
  }
  .app.start-mode .ach-panel .ach-grid {
    flex: 1;
    grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
    gap: 4px;
    align-content: start;
    overflow-y: auto;
  }
  .app.start-mode .ach-panel .ach-cell {
    font-size: 14px;
    height: 32px;
    border-radius: 4px;
  }

  .app.start-mode .start-btn-wrap {
    padding: 8px 10px;
  }
  .app.start-mode .start-btn {
    font-size: 17px;
    padding: 9px 28px;
    box-shadow: 0 4px 16px rgba(122,162,247,0.3), 0 0 20px rgba(224,175,104,0.15);
  }
  .app.start-mode .start-sub { font-size: 11px; margin-top: 4px; }

  .app.start-mode .footnote { font-size: 11px; line-height: 1.4; }

  .app.focus-mode .key { width: 52px; height: 52px; font-size: 16px; }
  .app.focus-mode .key.shift { width: 88px; font-size: 18px; }
  .app.focus-mode .key.space { width: 240px; font-size: 22px; }
  .app.focus-mode .finger { width: 64px; }
  .app.focus-mode .finger .pad svg { transform: scale(1.15); }
  .app.focus-mode .finger .home { font-size: 14px; min-width: 32px; }
  .app.focus-mode .finger .name { font-size: 12px; max-width: 64px; }
  .app.focus-mode .thumb-pad svg { width: 52px; }
  .app.focus-mode .text-display { font-size: min(3vw, 34px); }
  .app.focus-mode .text-display .char { font-size: min(3vw, 34px); }

  body { padding: 8px; }
}
