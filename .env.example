# === Server ===
PORT=3001
# Секретный ключ для JWT-токенов. Обязательно замените на свой длинный случайный!
# (в production сервер аварийно завершится, если оставить insecure-дефолт)
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d
DB_PATH=./data/toptiptop.db
# BASE_URL=http://localhost:3001

# === Admin account (auto-created at startup) ===
# Админ-аккаунт создаётся автоматически при старте сервера, если заданы
# ADMIN_EMAIL и ADMIN_PASSWORD. Вход в админ-панель: POST /api/auth/login
# (email + пароль), роль admin.
#
# - Вход выполняется по email, поэтому ADMIN_EMAIL должен быть реальным,
#   которым вы владеете (регистрация пользователей тоже идёт по email).
# - Если пользователь с таким email уже существует — при старте он будет
#   повышен до admin, разблокирован, подтверждён, а его пароль сброшен
#   на ADMIN_PASSWORD. Это гарантирует способ вернуть доступ после сброса
#   БД / смены роли / бана.
# - Меняйте ADMIN_PASSWORD в .env и перезапускайте сервер — пароль обновится.
# - Если пароль содержит пробелы или символ «#» — оберните его в кавычки.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD="смените-на-свой-надёжный-пароль"

# === Mail (email verification) ===
# В dev-режиме (без MAIL_HOST) коды подтверждения выводятся в консоль.
# Для production настройте SMTP:
# MAIL_HOST=smtp.yandex.ru
# MAIL_PORT=587
# MAIL_USER=your@email.com
# MAIL_PASS=your-app-password
# MAIL_FROM=your@email.com

# === Dev auto-verify ===
# true — регистрация проходит без подтверждения email (удобно для разработки)
DEV_AUTO_VERIFY=true
